{
  "name": "testalk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && HOME=\"$HOME/.pad-worker\" PAD_ENV=devnet pad dist proof-of-talk-v02.dot --env devnet --js-merkle",
    "check-deploy": "node scripts/check-deploy.ts",
    "verify": "node scripts/verify.ts",
    "icon": "node scripts/icon.ts",
    "bench-stt": "node --import ./scripts/ort-web-node.mjs scripts/bench-stt.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@huggingface/transformers": "4.3.0",
    "@noble/hashes": "^1.8.0",
    "@parity/product-sdk-host": "0.28.0",
    "@parity/product-sdk-signer": "0.17.3",
    "@phosphor-icons/core": "^2.1.1",
    "@polkadot/util": "^13.5.4",
    "@polkadot/util-crypto": "^13.5.4",
    "multiformats": "^13.3.7",
    "polkadot-api": "3.2.1",
    "qrcode": "^1.5.4",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/qrcode": "^1.5.5",
    "opentype.js": "^2.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
