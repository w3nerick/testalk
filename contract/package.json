{
  "name": "testalk-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TalkRegistry: sellos permanentes de recibos de testalk en Asset Hub (PolkaVM).",
  "scripts": {
    "build": "resolc --bin -O3 --output-dir out --overwrite contracts/TalkRegistry.sol && solc --abi --bin --optimize -o out-evm --overwrite contracts/TalkRegistry.sol",
    "test": "node test/registry.test.mjs",
    "simulate": "node scripts/deploy.mjs --simulate",
    "deploy": "node scripts/deploy.mjs",
    "anchor": "node scripts/anchor.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@polkadot-labs/hdkd": "^0.0.29",
    "@polkadot-labs/hdkd-helpers": "^0.0.31",
    "@polkadot/util": "^13.5.9",
    "@polkadot/util-crypto": "^13.5.9",
    "polkadot-api": "~2.2.1",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3"
  }
}
